---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "aargh@rai",
  description = "A small personal index for Aargh Rai. Software, systems, and other questionable decisions.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141514" />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
  </body>
</html>
