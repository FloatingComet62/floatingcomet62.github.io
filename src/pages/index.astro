  "CUDA", "OpenCV", "YOLO", "Tokio", "Axum", "React",
  "FastAPI", "Docker", "Kubernetes", "Redis", "Qdrant", "Nix",
];

const projects = [
  {
    name: "Gacrux",
    note: "A chess engine written in C. Teaching silicon to make questionable sacrifices.",
    tags: ["C", "Chess Engine", "Bitboards", "Alpha-Beta", "Multithreading", "UCI"],
    url: "https://git.aarghrai.com/gacrux",
  },
  {
    name: "GPT-2 from Scratch",
    note: "Reimplementing a language model to find out where the FLOPs go.",
    tags: ["C", "CUDA", "GPU"],
    url: "https://github.com/FloatingComet62/tinygpt",
  },
  {
    name: "QueJI",
    note: "For when your belongings go on an adventure without you. The cameras might know where they went.",
    tags: ["Python", "OpenCV", "YOLOv9", "Computer Vision", "Object Tracking"],
    url: "https://github.com/Hari21-Tech/QueJI",
